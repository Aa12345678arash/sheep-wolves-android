; Godot 4 project for WOLF-DUSK-008 portrait-first rebuild
config_version=5

[application]
config/name="گرگ و میش"
config/icon="res://assets/icon.svg"
config/description="راز دشت سبز - نسخه سه‌بعدی"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/size/mode=3
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.31, 0.48, 0.34, 1)
