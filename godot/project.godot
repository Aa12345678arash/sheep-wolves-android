; Godot 4 project scaffold for WOLF-DUSK-004
config_version=5

[application]
config/name="گرگ و میش"
config/description="راز دشت سبز - نسخه سه‌بعدی"
run/main_scene="res://scenes/main.tscn"

[rendering]
